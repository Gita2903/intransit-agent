# ── KONFIGURASI PORTAL IIA ────────────────────────────────────────────────────
IIA_BASE_URL=http://10.254.137.47/IIAWeb
IIA_LOGIN_URL=http://10.254.137.47/IIAWeb/Account/Login
IIA_USERNAME=username_iia
IIA_PASSWORD=password_iia
IIA_DATE1=01-January-2026
IIA_CLASS_ID=1
IIA_RESP_ID=91

# ── KONFIGURASI DIREKTORI LOKAL & FTP ─────────────────────────────────────────
ZIP_DIR=D:\intbk\zip_upload
ZIP_PREFIX=INTBK
OUTPUT_BASE=D:\intbk\extracted_csv
BA_FOLDER=D:\intbk\berita-acara
SCRIPTS_DIR=./tools

# FTP Tujuan Upload CSV
FTP_HOST=10.x.x.x
FTP_PORT=21
FTP_USER=ftp_user
FTP_PASS=ftp_pass
FTP_REMOTE=/

# FTP 214 = server yang sama dengan FTP tujuan upload di atas; download_ftp.py narik file BK dari sini
DOWNLOAD_BASE=D:\intbk\ftp_214
# Kode di nama file: BK<YYMMDD><BRANCH_CODE>.<ext> (default script: 99, pastikan sesuai punya lo)
BRANCH_CODE=99

# FTP 215 (Download 22 File BK Cabang)
FTP_HOST_215=10.x.x.215
FTP_PORT_215=21
FTP_USER_215=ftp_user_215
FTP_PASS_215=ftp_pass_215
FTP_REMOTE_215=/
DOWNLOAD_BASE_215=D:\intbk\ftp_215
FILE_CODE_215=12

# ── DB KANTOR (MySQL - Tempat rekap_selisih_bk & ba_rekonsiliasi) ─────────────
OFFICE_DB_HOST=127.0.0.1
OFFICE_DB_PORT=3306
OFFICE_DB_USER=root
OFFICE_DB_PASS=password_kantor
OFFICE_DB_NAME=intbk_db

# ── DB HOME LAB (MariaDB - Tempat aplikasi kurang_kirim) ──────────────────────
HOMELAB_DB_HOST=100.x.y.z
HOMELAB_DB_PORT=3306
HOMELAB_DB_USER=root
HOMELAB_DB_PASS=password_homelab
HOMELAB_DB_NAME=kurang_kirim

# ── EVOLUTION API (WhatsApp) ──────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=rendra-agent
EVOLUTION_API_KEY=your_evolution_api_key
RENDRA_WA_NUMBER=62812xxxxxxxx

# ── LLM (OpenAI-compatible, lewat 9router) ────────────────────────────────────
LLM_BASE_URL=http://localhost:20128/v1
# Model/combo per peran di 9router. Employee = worker, Leader & Manager = manager.
# Model WORKER harus support gambar (dipakai baca foto layar NPB dari PIC).
LLM_MODEL_WORKER=worker
LLM_MODEL_LEADER=manager
LLM_MODEL_MANAGER=manager
# Opsional: isi kalau 9router lo pasang API key
LLM_API_KEY=
LLM_TIMEOUT=60
# Isi 1 buat matiin AI total (parser WA pakai regex saja)
LLM_DISABLED=0

# ── BLAST PIC (opsional, ada default) ─────────────────────────────────────────
BLAST_COOLDOWN_HOURS=20
BLAST_TOP_N=10
BLAST_DELAY_MIN=6
BLAST_DELAY_MAX=14

# ── UMUR PRODUK / PENJUALAN TUNAI (opsional, ada default) ─────────────────────
EXP_MAPPING_PATH=./data/MAPPING4.xlsx
# Asumsi tgl produksi = tgl_kirim - N hari
PRODUCTION_LEAD_DAYS=1
# Sisa umur (hari) yang dianggap Penjualan Tunai
PENJUALAN_TUNAI_SISA_HARI=1
